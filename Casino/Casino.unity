    \u5C71\u672D\u306F\u5404\u5217\u306B1\u679A\u3001\u7A7A\u304D\u5217\u306A\u3057\u306E\u3068\u304D\u306E\u307F"
  - "\u914D\u5F53: \u7D44\u672D1\u679A\u306B\u3064\u304D20c + \u52DD\u5229\u30DC\u30FC\u30CA\u30B91.5\u500D"
  - "\u30AD\u30E3\u30F3\u30D5\u30A3\u30FC\u30EB\u30C9 - 3\u679A\u3081\u304F\u308A"
  - "\u76EE\u7684: 52\u679A\u3059\u3079\u3066\u30924\u3064\u306E\u7D44\u672D\u3078"
  - "\u30EB\u30FC\u30EB:\n- \u5834\u672D\u306F\u964D\u9806\u30FB\u8272\u4EA4\u4E92\u306B\u91CD\u306D\u308B\n-
    \u7D44\u672D\u306F\u57FA\u6E96\u30AB\u30FC\u30C9\u304B\u3089\u6607\u9806\u3001K\u306E\u6B21\u306FA\n-
    \u5C71\u672D\u304B\u30893\u679A\u3081\u304F\u308A\u3001\u4E00\u756A\u4E0A\u306E\u307F\u4F7F\u7528\u53EF\n-
    \u7A7A\u304D\u5217\u306F\u4E88\u5099\u672D\u304B\u3089\u81EA\u52D5\u88DC\u5145"
