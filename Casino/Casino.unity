  - "\u304A\u5F85\u3061\u304F\u3060\u3055\u3044"
  - "\u672A\u6E80\u306E\u65B9\u306E\u307F <"
  - "\u53D7\u3051\u53D6\u308B"
  - "\u79D2"
  - "\u52DD\u5229!"
  - "\u7372\u5F97"
  - "\u914D\u5F53:"
  - "\u3067\u30B9\u30BF\u30FC\u30C8"
  - "\u30B2\u30FC\u30E0\u3092\u3084\u3081\u307E\u3059\u304B\uFF1F"
  - "\u30AB\u30FC\u30C9\u306E\u88CF\u9762"
  - "\u30E9\u30F3\u30AD\u30F3\u30B0"
  - "\u30AF\u30EC\u30B8\u30C3\u30C8"
  - "\u30B5\u30DD\u30FC\u30BF\u30FC"
  - "\u8A00\u8A9E"
  - "\u8A2D\u5B9A"
  - "\u306F\u3044"
  - "\u3044\u3044\u3048"
  - "\u30DD\u30B9\u30C8\u30D7\u30ED\u30BB\u30C3\u30B7\u30F3\u30B0"
  - "\u52B9\u679C\u97F3"
  - BGM
  - "\u3053\u306E\u30B2\u30FC\u30E0\u306E\u30AA\u30FC\u30CA\u30FC\u306E\u307F\u7D42\u4E86\u3067\u304D\u307E\u3059\u3002"
  - "\u30AB\u30FC\u30C9\u3092\u914D\u3063\u3066\u3044\u307E\u3059\u3002"
  - "\u4ED6\u306E\u30D7\u30EC\u30A4\u30E4\u30FC\u306E\u30B2\u30FC\u30E0\u304C\u9032\u884C\u4E2D\u3067\u3059\u3002"
  - "\u65E2\u306B\u30B2\u30FC\u30E0\u3092\u9032\u884C\u4E2D\u3067\u3059\u3002\u5148\u306B\u7D42\u4E86\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
  - "\u6B8B\u9AD8\u304C\u8DB3\u308A\u307E\u305B\u3093\u3002"
  - "\u5C71\u672D\u304C\u7A7A\u3067\u3059\u3002"
  - "\u5168\u3066\u306E\u5217\u3092\u57CB\u3081\u3066\u304B\u3089\u914D\u3063\u3066\u304F\u3060\u3055\u3044\u3002"
  - "\u623B\u3059\u30AB\u30FC\u30C9\u304C\u3042\u308A\u307E\u305B\u3093\u3002"
  - "\u3042\u306A\u305F\u306E\u30B2\u30FC\u30E0\u3067\u306F\u3042\u308A\u307E\u305B\u3093\u3002"
  - "\u30AB\u30FC\u30C9\u306F\u88CF\u5411\u304D\u3067\u3059\u3002"
  - "\u4E00\u756A\u4E0A\u306E\u30AB\u30FC\u30C9\u306E\u307F\u53D6\u308C\u307E\u3059\u3002"
  - "\u57FA\u790E\u306E\u4E00\u756A\u4E0A\u306E\u30AB\u30FC\u30C9\u306E\u307F\u52D5\u304B\u305B\u307E\u3059\u3002"
  - "\u540C\u3058\u30B9\u30FC\u30C4\u306E\u30B0\u30EB\u30FC\u30D7\u306E\u307F\u52D5\u304B\u305B\u307E\u3059\u3002"
  - "\u30C0\u30FC\u30AF\u30E2\u30FC\u30C9"
  - "\u30E9\u30A4\u30C8\u30E2\u30FC\u30C9"
  - " (\u30B5\u30DD\u30FC\u30BF\u30FC\u9650\u5B9A)"
  - "\u30AF\u30ED\u30F3\u30C0\u30A4\u30AF - 1\u679A\u3081\u304F\u308A"
  - "\u76EE\u7684: 52\u679A\u3059\u3079\u3066\u30924\u3064\u306E\u7D44\u672D\u3078\u3001A\u2192K\u306E\u9806\u3067\u7A4D\u3080"
  - "\u30EB\u30FC\u30EB:\n- \u5834\u672D\u306F\u964D\u9806\u30FB\u8272\u4EA4\u4E92\u306B\u91CD\u306D\u308B\n-
    \u7A7A\u304D\u5217\u306B\u306FK\u306E\u307F\u7F6E\u3051\u308B"
  - "\u914D\u5F53: \u7D44\u672D1\u679A\u306B\u3064\u304D10c"
  - "\u30B9\u30D1\u30A4\u30C0\u30FC - 2\u30B9\u30FC\u30C4"
  - "\u76EE\u7684: 104\u679A\u3059\u3079\u3066\u30928\u3064\u306E\u7D44\u672D\u3078\u3001K\u2192A\u306E\u9806\u3067\u7A4D\u3080"
  - "\u30EB\u30FC\u30EB:\n- \u5834\u672D\u306F\u964D\u9806\u306B\u91CD\u306D\u308B\n-
    \u540C\u8272\u306E\u9023\u7D9A\u5217\u306E\u307F\u307E\u3068\u3081\u3066\u79FB\u52D5\n-
