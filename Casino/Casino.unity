  - "\u6D3E\u5F69: \u6BCF\u5F20\u57FA\u7840\u724C10c"
  - "\u8718\u86DB\u7EB8\u724C - \u53CC\u82B1\u8272"
  - "\u76EE\u6807: \u5C06\u5168\u90E8104\u5F20\u724C\u6309\u82B1\u8272\u4ECE K \u2192
    A \u79FB\u52308\u4E2A\u57FA\u7840\u724C\u5806"
  - "\u89C4\u5219:\n- \u724C\u5217\u6309\u964D\u5E8F\u5806\u53E0\n- \u53EA\u80FD\u6574\u4F53\u79FB\u52A8\u540C\u8272\u7684\u8FDE\u7EED\u724C\u7EC4\n-
    \u4EFB\u4F55\u724C\u90FD\u53EF\u653E\u5230\u7A7A\u5217\n- \u724C\u5806\u6BCF\u5217\u53D11\u5F20\uFF0C\u4E14\u4EC5\u5F53\u65E0\u7A7A\u5217\u65F6"
  - "\u6D3E\u5F69: \u6BCF\u5F20\u57FA\u7840\u724C20c + 1.5\u500D\u80DC\u5229\u5956\u52B1"
  - "\u574E\u83F2\u5C14\u5FB7 - \u4E09\u5F20\u7FFB\u724C"
  - "\u76EE\u6807: \u5C06\u5168\u90E852\u5F20\u724C\u79FB\u52304\u4E2A\u57FA\u7840\u724C\u5806"
  - "\u89C4\u5219:\n- \u724C\u5217\u6309\u964D\u5E8F\u3001\u989C\u8272\u4EA4\u66FF\u5806\u53E0\n-
