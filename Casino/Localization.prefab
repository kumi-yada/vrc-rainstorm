  - BGM
  - "\u3053\u306E\u30B2\u30FC\u30E0\u306E\u30AA\u30FC\u30CA\u30FC\u306E\u307F\u7D42\u4E86\u3067\u304D\u307E\u3059\u3002"
  - "\u30AB\u30FC\u30C9\u3092\u914D\u3063\u3066\u3044\u307E\u3059\u3002"
  - "\u4ED6\u306E\u30D7\u30EC\u30A4\u30E4\u30FC\u306E\u30B2\u30FC\u30E0\u304C\u9032\u884C\u4E2D\u3067\u3059\u3002"
  - "\u65E2\u306B\u30B2\u30FC\u30E0\u3092\u9032\u884C\u4E2D\u3067\u3059\u3002\u5148\u306B\u7D42\u4E86\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
  - "\u6B8B\u9AD8\u304C\u8DB3\u308A\u307E\u305B\u3093\u3002"
  - "\u5C71\u672D\u304C\u7A7A\u3067\u3059\u3002"
  - "\u5168\u3066\u306E\u5217\u3092\u57CB\u3081\u3066\u304B\u3089\u914D\u3063\u3066\u304F\u3060\u3055\u3044\u3002"
  - "\u623B\u3059\u30AB\u30FC\u30C9\u304C\u3042\u308A\u307E\u305B\u3093\u3002"
  - "\u3042\u306A\u305F\u306E\u30B2\u30FC\u30E0\u3067\u306F\u3042\u308A\u307E\u305B\u3093\u3002"
  - "\u30AB\u30FC\u30C9\u306F\u88CF\u5411\u304D\u3067\u3059\u3002"
  - "\u4E00\u756A\u4E0A\u306E\u30AB\u30FC\u30C9\u306E\u307F\u53D6\u308C\u307E\u3059\u3002"
  - "\u57FA\u790E\u306E\u4E00\u756A\u4E0A\u306E\u30AB\u30FC\u30C9\u306E\u307F\u52D5\u304B\u305B\u307E\u3059\u3002"
  - "\u540C\u3058\u30B9\u30FC\u30C4\u306E\u30B0\u30EB\u30FC\u30D7\u306E\u307F\u52D5\u304B\u305B\u307E\u3059\u3002"
