  - "\u4E0A\u90E8\u306E4\u3064\u306E\u57FA\u790E\u30AB\u30FC\u30C9\u3092A\u2192K\u306E\u9806\u3067\u4F5C\u308B"
  - "\u30EB\u30FC\u30EB:\n- \u5DE6\u4E0A\u306E\u5C71\u672D\u306F1\u679A\u305A\u3064\u3001\u4F55\u5EA6\u3067\u3082\u3081\u304F\u308C\u308B\n-
    \u4E0B\u306E\u30AB\u30FC\u30C9\u5217\u306F\u964D\u9806\u30FB\u8272\u4EA4\u4E92\u3067\u306E\u307F\u7F6E\u3051\u308B\n-
    \u4E0B\u306E\u7A7A\u304D\u30B9\u30ED\u30C3\u30C8\u306B\u306FK\u306E\u307F\u7F6E\u3051\u308B"
  - "\u914D\u5F53: \u7D44\u672D1\u679A\u306B\u3064\u304D10c + 1.25\u500D\u52DD\u5229\u30DC\u30FC\u30CA\u30B9"
  - "\u30B9\u30D1\u30A4\u30C0\u30FC - 2\u30B9\u30FC\u30C4"
  - "8\u3064\u306E\u7D44\u672D\u3092K\u2192A\u306E\u9806\u3067\u4F5C\u308B"
  - "\u30EB\u30FC\u30EB:\n- \u30D5\u30A3\u30FC\u30EB\u30C9\u4E0A\u3067\u30AB\u30FC\u30C9\u306E\u5C71\u5168\u4F53\u3092\u4F5C\u3063\u3066\u304B\u3089\u7D44\u672D\u306B\u79FB\u52D5\u3059\u308B\n-
